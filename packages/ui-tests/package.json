{
  "name": "@qa/ui-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "UI automation for the DemoQA Book Store application",
  "scripts": {
    "test:e2e": "playwright test --grep-invert @visual",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:visual": "docker compose run --rm e2e --grep @visual",
    "test:visual:update": "docker compose run --rm visual-baselines",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:mutation": "stryker run",
    "typecheck": "tsc --noEmit",
    "report:merge": "playwright merge-reports --reporter=html,junit ./blob-report",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@ghostery/adblocker-playwright": "^2.18.2",
    "@playwright/test": "^1.56.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^24.13.3",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  }
}
