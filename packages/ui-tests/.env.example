# Base URL of the application under test.
E2E_BASE_URL=https://demoqa.com

# Base URL of the Book Store REST API used to seed and tear down test state.
# The DemoQA deployment serves the API from the same origin as the UI.
E2E_API_BASE_URL=https://demoqa.com

# Playwright projects to run. Comma separated: chromium, firefox, webkit.
E2E_BROWSERS=chromium

# Run browsers without a visible window. Set to false for local debugging.
E2E_HEADLESS=true

# Per-test timeout in milliseconds.
E2E_TEST_TIMEOUT_MS=60000

# Budget for a single navigation, in milliseconds. Must be strictly below
# E2E_TEST_TIMEOUT_MS, or a page that never loads exhausts the test at the same
# moment and is reported as a bare test timeout rather than as a failure to
# load. Leave unset to take three quarters of the test budget, which holds that
# invariant whatever the test budget is.
# E2E_NAVIGATION_TIMEOUT_MS=45000

# Per-assertion timeout in milliseconds. Applies to interface actions only.
E2E_EXPECT_TIMEOUT_MS=10000

# Timeout for calls to the Book Store service, used to seed and tear down test
# state. Kept separate from the interface budget: the public DemoQA deployment
# answers account creation and token generation in roughly three to eight
# seconds, well beyond any reasonable budget for a click.
E2E_API_TIMEOUT_MS=30000

# Retry count for failed tests. Kept at 0 locally so flakiness is visible.
E2E_RETRIES=0

# Parallel worker count. Leave unset to let Playwright pick based on CPU count.
# E2E_WORKERS=4
