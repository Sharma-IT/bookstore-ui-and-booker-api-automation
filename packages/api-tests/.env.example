# Base URL of the Restful Booker service under test.
BOOKER_BASE_URL=https://restful-booker.herokuapp.com

# Per-request timeout in milliseconds. The public deployment runs on a free dyno
# that sleeps when idle, so this is generous by design.
BOOKER_TIMEOUT_MS=30000

# Credentials. These are the ones the service documents publicly, so they are
# defaults rather than secrets. Override them for a private instance.
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123

# Retry count for failed tests. Kept at 0 locally so flakiness stays visible.
BOOKER_RETRIES=0
