{
  "name": "qa-automation-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "UI automation for the DemoQA Book Store and API automation for Restful Booker",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "verify": "npm run typecheck && npm run lint && npm run format && npm run test:unit && npm run test:mutation",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:mutation": "npm run test:mutation --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@qa/ui-tests",
    "test:api": "npm run test --workspace=@qa/api-tests",
    "install:browsers": "npm run install:browsers --workspace=@qa/ui-tests"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-playwright": "^2.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
