{
  "name": "bookstore-ui-and-booker-api-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Task 1 UI automation for the DemoQA Book Store, and Task 2 API automation for the Restful Booker service",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "verify": "npm run typecheck && npm run lint && npm run lint:workflows && npm run format && npm run test:unit && npm run test:mutation",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:workflows": "action-validator .github/workflows/ci.yml",
    "test": "npm run test:api && npm run test:e2e",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:mutation": "npm run test:mutation --workspaces --if-present",
    "test:api": "npm run test --workspace=@qa/api-tests",
    "test:api:watch": "npm run test:watch --workspace=@qa/api-tests",
    "test:api:smoke": "npm run test:smoke --workspace=@qa/api-tests",
    "test:api:unit": "npm run test:unit --workspace=@qa/api-tests",
    "test:api:mutation": "npm run test:mutation --workspace=@qa/api-tests",
    "test:e2e": "npm run test:e2e --workspace=@qa/ui-tests",
    "test:e2e:ui": "npm run test:e2e:ui --workspace=@qa/ui-tests",
    "test:e2e:headed": "npm run test:e2e:headed --workspace=@qa/ui-tests",
    "test:e2e:smoke": "npm run test:smoke --workspace=@qa/ui-tests",
    "test:e2e:unit": "npm run test:unit --workspace=@qa/ui-tests",
    "test:e2e:mutation": "npm run test:mutation --workspace=@qa/ui-tests",
    "install:browsers": "npm run install:browsers --workspace=@qa/ui-tests"
  },
  "devDependencies": {
    "@action-validator/cli": "^0.6.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-playwright": "^2.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
